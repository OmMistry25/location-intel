# Environment variables for location-intel
#
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real secrets.
#
# This file documents every external dependency that needs a credential.
# If you add a new source that needs auth, add it here.

# ============================================================================
# Database — Supabase
# ============================================================================

# Get from your Supabase project dashboard → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # Server-side only. Never expose to client.

# Direct Postgres connection (for migrations, bulk ingestion)
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# ============================================================================
# Data sources — free tier API keys
# ============================================================================

# US Census Bureau (ACS) — free, instant signup
# https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# DataSF (Socrata) — optional but lifts rate limits
# https://data.sfgov.org/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# 511.org Bay Area transit (GTFS feeds) — free signup
# https://511.org/open-data/token
BAY_AREA_511_API_KEY=

# EPA AirNow — free key
# https://docs.airnowapi.org/account/request/
EPA_AIRNOW_API_KEY=

# PurpleAir — paid API (cheap, ~$5-20/mo at our scale)
# Provides dense air quality + temperature/humidity readings (microclimate)
# https://api.purpleair.com/
PURPLEAIR_API_READ_KEY=
PURPLEAIR_API_WRITE_KEY=   # Only needed if we ever push data; readonly is enough for ingestion

# NREL (alt fuels / EV charging) — free key
# https://developer.nrel.gov/signup/
NREL_API_KEY=

# NOAA NCEI — free token
# https://www.ncdc.noaa.gov/cdo-web/token
NOAA_TOKEN=

# ============================================================================
# Storage
# ============================================================================

# Supabase Storage for non-DB files (large geometries, periodic dumps)
SUPABASE_STORAGE_BUCKET=location-intel-storage

# ============================================================================
# Application config
# ============================================================================

# Environment: development | staging | production
APP_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
